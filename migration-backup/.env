# Optional environment overrides. Anything set here wins over config.json so the
# committed config file stays deployment-neutral. Copy to `.env`.

# Path to the config file (default: ./config.json)
# LAB_CONNECTOR_CONFIG=./config.json

# Override the HMIS base URL
# HMIS_BASE_URL=https://hmis.your-hospital.com

# Log level: trace | debug | info | warn | error
# LOG_LEVEL=info

# Dashboard credential. ADMIN_USERNAME / ADMIN_PASSWORD are read only on the
# start that seeds admin-auth.json — afterwards the file is the source of truth
# and the password is changed from the dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Zydus@2026
# ADMIN_AUTH_FILE=./admin-auth.json
