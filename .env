# Optional environment overrides. Anything set here wins over config.json, so
# the committed config file can stay deployment-neutral.

# The real HMIS gateway. Until this (or hmis.baseUrl in config.json) points at
# the live server, the connector still runs and results queue in the durable
# spool — nothing is lost, nothing is filed.
# HMIS_BASE_URL=https://hmis.your-hospital.com

# LOG_LEVEL=info
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Zydus@2026
# ---------------------------------------------------------------------------
# Tatva v1 (hmis.tatva) — each of these wins over config.json when set.
# .env is committed to git: keep real secrets in config.json (gitignored) or
# in the machine's own environment, not here.
# ---------------------------------------------------------------------------
# TATVA_ENABLED=true
# TATVA_AUTH=equipment                      # equipment | oauth
# TATVA_BASE_URL=https://hmispreprod.zydushospitals.com
# TATVA_API_PREFIX=/external/v1             # oauth only
# TATVA_CLIENT_ID=                          # oauth only
# TATVA_CLIENT_SECRET=                      # oauth only
# TATVA_SCOPE=lab.equipment.worklist.read lab.equipment.acknowledge lab.equipment.result.publish
# TATVA_API_KEY=                            # X-Api-Key, PROD when issued
# TATVA_FACILITY_ID=                        # X-Facility-ID
# TATVA_ORGANIZATION_ID=                    # X-Organization-ID
# TATVA_TLS_CERT_FILE=                      # mTLS, only if required
# TATVA_TLS_KEY_FILE=
# TATVA_TLS_CA_FILE=
# TATVA_TLS_PASSPHRASE=
# Per machine (equipment auth): <ID> = analyzer id upper-cased, "-" as "_"
# TATVA_EQUIPMENT_ID_MAGLUMI=
# TATVA_EQUIPMENT_SECRET_MAGLUMI=
