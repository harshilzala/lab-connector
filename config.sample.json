{
  // ===========================================================================
  // CONFIG LIBRARY — generated by `npm run config:sample`. Do not edit by hand;
  // edit a config.json and re-run it (npm run deploy also refreshes it).
  //
  // Every analyzer block and every top-level setting ever seen in a config file
  // — this checkout's, a deployment folder's, or one passed on the command
  // line — collected in one place. Each entry lists the files it came from:
  //
  //   "config.json"                    live in that file
  //   "config.json [commented out]"    parked in a // comment there
  //   "config.json [removed]"          was in that file, has since been deleted
  //
  // TO USE ONE: copy its "block" into the "analyzers" array of any config.json
  // (or a "value" in as that top-level key), then change what is specific to
  // the new site — id, equipmentCode, siteIds, the transport's host / port.
  //
  // SECRETS ARE NOT HERE. Passwords, client secrets, API keys, tokens and the
  // user / client id beside them are blank (""): fill them in the site's own
  // config.json, or better its .env (AUTOCERTIFY_ORACLE_PASSWORD,
  // GENX_CLIENT_ID, GENX_CLIENT_SECRET, GENX_API_KEY).
  //
  // "profiles" lists every instrument model the connector knows. A new machine
  // of a listed model needs no more than:
  //   { "id": "...", "profile": "<name>", "equipmentCode": "...",
  //     "transport": { "type": "tcp", "mode": "server", "host": "0.0.0.0", "port": <port> } }
  // ===========================================================================

  "profiles": {
    "mindray-bc5150": "Mindray BC-5000 / BC-5150 5-part haematology analyzer, HL7 v2.3.1 over MLLP; analyzer is the TCP server on port 5100",
    "mindray-bc5000": "Mindray BC-5000 / BC-5150 5-part haematology analyzer, HL7 v2.3.1 over MLLP; analyzer is the TCP server on port 5100",
    "mindray-bc6000": "Mindray BC-6000 5-part haematology analyzer, HL7 v2.3.1 over MLLP; analyzer dials the LIS",
    "erba-h360": "Erba H360 3-part haematology analyzer, HL7 v2.3.1 over MLLP; analyzer dials the LIS",
    "lifotronic-gh900plus": "Lifotronic GH900 Plus HbA1c analyzer, proprietary fixed-width block over TCP; analyzer dials the LIS (PC is server, default port 8000)",
    "vitros-eciq": "Ortho/QuidelOrtho VITROS ECi / ECiQ immunodiagnostic, ASTM E1381/E1394 over serial; reached through a Moxa NPort the connector dials",
    "vitros-eci": "Ortho/QuidelOrtho VITROS ECi / ECiQ immunodiagnostic, ASTM E1381/E1394 over serial; reached through a Moxa NPort the connector dials",
    "vitros-250": "Ortho/QuidelOrtho VITROS 250 chemistry, KERMIT file transfer over serial; reached through a Moxa NPort the connector dials",
    "snibe-maglumi": "Snibe Maglumi chemiluminescence immunoassay analyzer, ASTM E1381/E1394 over TCP; analyzer dials the LIS and host-queries each tube",
    "sysmex-uf4000": "Sysmex UF-4000 / UF-5000 urine particle analyzer, ASTM E1381/E1394 over TCP; analyzer dials the LIS and host-queries each tube",
    "sysmex-uf5000": "Sysmex UF-4000 / UF-5000 urine particle analyzer, ASTM E1381/E1394 over TCP; analyzer dials the LIS and host-queries each tube",
    "sysmex-uc3500": "Sysmex UC-3500 urine chemistry (test strip) analyzer, ASTM E1381/E1394 over RS-232C; host-queries each tube. Site block gives the COM port (or an NPort to dial)",
    "sysmex-uwam": "Sysmex U-WAM urinalysis work-area manager fronting a UC-3500 + UF-4000/UF-5000 pair, ASTM E1381/E1394 over TCP; one link carries both instruments' results per sample",
    "im": "IM instrument middleware (chemistry / immunoassay line), HL7 over MLLP on two channels — orders PUSHED to it as ORM^O01 (IM listens on 10011, the connector dials), results RECEIVED from it as ORU^R01 (the connector listens on 10012, IM dials)"
  },

