    //   "transport": { "type": "tcp", "mode": "server", "host": "0.0.0.0", "port": 6082 }
    // }

    // Alternative — ONE link through the U-WAM PC carrying both instruments'
    // values (SETUP-SYSMEX-URINE.md, route A). Use INSTEAD of the two blocks
    // above, never alongside them.
    {
      "id": "sysmex-uwam",
      "profile": "sysmex-uwam",
      "equipmentCode": "EC022",
      // HMIS splits the same urine service across two equipment codes for the
      // same tubes (gateway rows, 2026-09-17): EC014 carries the UF-4000
      // particle parameters (RBC, NL RBC, SRC, Lysed RBC, MUCUS, YLC, SPERM,
      // Tran.EC, WBC Clumps), ZCCEC002 — the retired middleware's code — the
      // UC-3500 strip parameters (LEU, COL, ERY). One U-WAM message carries
      // both, so both codes are polled and merged.
      "extraEquipmentCodes": ["ZCCEC002"],
      // HMIS's identifiers for the strip rows differ from the U-WAM's own
      // codes ("C-LEU" on the wire, "LEU" in HMIS). Consulted only when the
      // wire code matches no pending row.
      // RBC-Info. / BACT-Info. (the U-WAM's spelling, with the dot) file into
      // HMIS's "RBC Morphology" / "Type of Bacteria" rows, registered as
      // RBC-Info / BACT-Info (no dot). The profile turns the codes into words.
      "testCodeAliases": { "C-LEU": "LEU", "C-COLOR": "COL", "C-BLD": "ERY", "RBC-Info.": "RBC-Info", "BACT-Info.": "BACT-Info" },
      // The HMIS master registers the strip's C-PRO under this equipment TWICE:
      // on the Urine examination protein row (service 414, parameterId 94) AND
      // on the Microalbumin/Creatinine RATIO (service 128, parameterId 5164 —
      // the row the chemistry analysers file the real ratio into). Seven
      // samples had a strip "-" written over that ratio on 2026-09-17/18
      // (LB2609170689, LB2609180203/231/328/349/399). Never file there;
      // remove the C-PRO mapping from parameter 5164 in the HMIS master.
      "excludeParameterIds": [5164],
      // The urine report shows these counts as whole numbers; the UF-4000
      // sends them in /HPF or /LPF with one decimal ("0.9"). Asked for on
      // 2026-09-19: first the four epithelial cell counts, then RBC and
      // crystals (X'TAL). WBC, casts and bacteria keep the instrument's decimal.
      // Casts as whole numbers too (lab, 2026-09-21): "2.43 /LPF" -> 2.
      "testCodeDecimals": { "EC": 0, "Squa.EC": 0, "Non SEC": 0, "RTEC": 0, "RBC": 0, "X'TAL": 0, "CAST": 0, "Hy.CAST": 0, "Path.CAST": 0 },
      // Both analyzers behind the U-WAM run the same tube, and the U-WAM does
      // not always send their halves together: on 2026-09-17/18/19, 60 of 239
      // samples arrived as one instrument's message followed by the other's.
      // Filing the first half on its own marked the urine panel "result
      // interfaced" in HMIS and the report printed with the other
      // instrument's rows blank — the partial transfer the lab reported.
      //
      // So a sample is HELD until both instruments have reported, then filed
      // in one post the moment the second half lands. The lab's rule
      // (2026-09-19): HMIS must NOT show the panel as interfaced until both
      // machines' data are in, so there is NO time limit on the hold
      // ("maxWaitMs": null). A tube run on one machine only, or a day with
      // one machine down, stays in the queue until an operator presses
      // "file now" on the console for it. To file such tubes automatically
      // after a wait instead, set "maxWaitMs" to a number of milliseconds
      // (the profile default is 600000 = 10 minutes).
      "filing": {
        "mode": "staged",
        "pairing": { "devices": ["UC-3500", "UF-4000"], "maxWaitMs": null }
      },
      "protocol": "astm",
      "transport": { "type": "tcp", "mode": "server", "host": "0.0.0.0", "port": 2031 }
    }

    // ************************************************************************
    // REPLACED on 2026-10-12 by the top-level "im" block above. Kept only as a
    // record of the old layout — DO NOT uncomment: IM would then be declared
    // twice and the config refuses to load.
    // ************************************************************************
    // ------------------------------------------------------------------------
    // IM — the instrument middleware in front of the chemistry / immunoassay
    // line. NOT an analyzer: IM runs the tubes on the machines itself, and it
    // never asks for work — it LISTENS and takes every order the LIS sends it.
    // That feed came from Mirth; with this block the connector reads the
    // orders from HMIS itself (the same /mirth/pending poll every other
    // machine here uses) and sends them straight to IM.
    //
    // LIVE since 2026-09-27. The Mirth channel that feeds IM must be STOPPED
    // while this block is on: two systems sending the same orders puts every
    // tube on IM's worklist twice. To switch this block off without deleting
    // it, set "orderPoll": { "enabled": false } — orders are then neither
    // read nor sent, and the result channel keeps listening.
    //
    // What is confirmed (2026-09-27): HMIS registers this machine as EQ0022
    // and lists ~95 rows / 24 tubes a day for it, with 10.11.111.129:10011 in
    // its own ipAddress/portNo columns. 10.11.4.231:10011 accepts a connection
    // from this PC and does not answer an ASTM ENQ, so the framing is not
    // ASTM — the block speaks HL7 over MLLP. The MESSAGE LAYOUT is the HL7 v2
    // standard one and is NOT yet confirmed against IM: commission it by
    // sending one tube and reading IM's acknowledgement. AE/AR names what it
    // did not like, in the log and on the console, and everything that might
    // differ is a setting here — messageType, version, receivingApp,
    // receivingFacility, processingId.
    //
    // Note the site list: EQ0022 carries tubes from five sites (Ahmedabad,
    // Chandkheda CF*, Vadodara ZV*, Anand ZN*, Ramanbhai ZS*), so polling
    // with siteId=2 alone would hide 38 of the 95 rows.
    //
    // TWO CHANNELS, both shown on the console's Auto Certify page:
    //   ORDER channel   the connector DIALS IM on 10.11.4.231:10011 and sends
    //                   it every order ("transport").
    //   RESULT channel  the connector LISTENS on this PC, port 10012, and IM
    //                   dials in with the same tubes and their values
    //                   ("resultTransport"). Each value is joined to the order
    //                   that went out and filed in HMIS.
    // 10012 is this PC's choice, not a port IM was found sending to: IM's
    // result connection has to be pointed at 10.11.103.21:10012 — or, if IM
    // already sends results to a port, put that port here instead.
    // ------------------------------------------------------------------------
    // {
    //   "id": "im",
    //   "profile": "im",
    //   "equipmentCode": "EQ0022",
    //   "equipmentId": 46150218,
    //   "siteIds": ["2", "13873256", "5866265", "14", "2567859"],

    //   "protocol": "hl7",

    //   // ---- OUT: the ORDER channel -------------------------------------------
    //   // The connector DIALS IM and sends it every order HMIS raises for
    //   // EQ0022. "client" = this PC opens the connection.
    //   "transport": {
    //     "type": "tcp",
    //     "mode": "client",
    //     "host": "10.11.4.231",
    //     "port": 10011
    //   },

    //   // ---- IN: the RESULT channel -------------------------------------------
    //   // The connector LISTENS on this PC and IM dials in with the same tubes
    //   // and their values. "server" = IM opens the connection. IM's result
    //   // connection has to point at 10.11.103.21:10012.
    //   "resultTransport": {
    //     "type": "tcp",
    //     "mode": "server",
    //     "host": "0.0.0.0",
    //     "port": 10012
    //   },

    //   // Orders are read from HMIS every minute and sent as they appear.
    //   // "download": false collects them without sending anything to IM.
    //   "orderPoll": {
    //     "enabled": true,
    //     "download": true,
    //     "intervalMs": 60000,
    //     "lookbackDays": 1
    //   },

    //   // Patient name, id, sex and date of birth go with each order.
    //   "sendDemographics": true,
    //   "hostQuery": false,

    //   "hl7": {
    //     "sendingApp": "HMIS-LIS",      // MSH-3 on every order
    //     "sendingFacility": "",         // MSH-4
    //     "charset": "",                 // MSH-18, left out while empty
    //     "ack": true,                   // acknowledge every result IM sends
    //     "valueTypes": [],              // every OBX type: numbers AND words
    //     "orderPush": {
    //       "enabled": true,
    //       "messageType": "ORM^O01",    // or "OML^O21"
    //       "version": "2.3.1",          // MSH-12
    //       "receivingApp": "IM",        // MSH-5
    //       "receivingFacility": "",     // MSH-6
    //       "processingId": "P",         // MSH-11: P production, T training
    //       "ackTimeoutMs": 15000        // no answer in this long = not sent
    //     }
    //   }
    // }
  ]
}

