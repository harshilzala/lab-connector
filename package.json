{
  "name": "hmis-lab-connector",
  "version": "0.1.0",
  "private": true,
  "description": "Bidirectional LIS middleware between Siemens Atellica (ASTM E1381/E1394 or HL7) analyzers and the HMIS lab API. Runs on a local lab PC.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "lab-connector": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "simulator": "tsx test/analyzer-simulator.ts",
    "dialects": "tsx test/dialects-check.ts",
    "sniff": "tsx test/serial-sniff.ts",
    "ping": "tsx test/ping-server.ts",
    "install-service": "node dist/index.js --install-service",
    "uninstall-service": "node dist/index.js --uninstall-service",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs",
    "pm2:restart": "npm run build && pm2 restart ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs lab-connector",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save",
    "sniff:tcp": "tsx test/tcp-sniff.ts",
    "kermit": "tsx test/kermit-check.ts",
    "kermit:corpus": "tsx test/kermit-corpus.ts",
    "h360": "tsx test/hl7-h360.test.ts",
    "h360:corpus": "tsx test/h360-corpus.ts",
    "config": "tsx test/config-jsonc.test.ts",
    "replay": "tsx test/replay-message.ts",
    "h360:join": "tsx test/h360-hmis-join.test.ts",
    "ack": "tsx test/ack-after-file.test.ts",
    "pm2:logrotate": "pm2 install pm2-logrotate && pm2 set pm2-logrotate:max_size 10M && pm2 set pm2-logrotate:retain 7 && pm2 set pm2-logrotate:compress true && pm2 set pm2-logrotate:rotateInterval \"0 0 * * *\" && pm2 set pm2-logrotate:dateFormat YYYY-MM-DD_HH-mm-ss && pm2 set pm2-logrotate:rotateModule true && pm2 set pm2-logrotate:workerInterval 30"
  },
  "dependencies": {
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "allowScripts": {
    "@serialport/bindings-cpp@12.0.1": true,
    "esbuild@0.28.1": true
  }
}
