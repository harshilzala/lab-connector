node_modules/
dist/
*.log
logs/

# Runtime state — durable store-and-forward spool + local message log.
# NEVER commit: may contain patient result data.
spool/
data/

# Local configuration — per-site analyzer wiring, HMIS URL, equipment ids and
# COM/TCP endpoints. Differs on every machine. Copy from config.example.json
# and keep out of version control.
config.json

# Local dashboard credential (scrypt hash + recovery key hash). Seeded on
# first start — never commit.
admin-auth.json


# Local code-graph index (tokensave). Machine-local SQLite state — never commit.
.tokensave/

# curl cookie jar from dashboard testing — carries a live session id.
cookies.txt

# wire captures from npm run sniff / sniff:tcp
captures/

# throwaway scratch files (scripts, staged samples) — never committed
.scratch/
