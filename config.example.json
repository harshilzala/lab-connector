{
  // ===========================================================================
  // Template for config.json. Copy it and fill in the real values:
  //
  //     cp config.example.json config.json
  //
  // config.json is gitignored, so the live values (site IPs, HMIS equipment
  // codes) stay out of version control and THIS file is the only committed
  // record of the shape. Keep it in step when the schema changes — and keep
  // real hosts, equipment codes and the production HMIS URL OUT of it.
  //
  // Read as JSONC: `//` and `/* */` comments and trailing commas are allowed,
  // so an alternative transport can be parked beside the live one instead of
  // being deleted (see the commented serial blocks below).
  // ===========================================================================

  "logLevel": "info",
  "spoolDir": "./spool",

  // Housekeeping for the rolling logs and the delivered-result spool.
  "retention": {
    "days": 7,
    "logDays": 30,
    "sweepIntervalHours": 6,
    "logDir": "./logs",
    "includeSpoolPending": true
  },

  // The three /mirth/* endpoints. UNAUTHENTICATED — the analyzer is identified
  // only by the `eqCode` query parameter, so keep the connector on the lab VLAN.
  // resultsPath differs per deployment ("/mirth/results" vs "/mirth/labresult");
  // confirm it against the gateway before going live.
  "hmis": {
    "baseUrl": "https://hmis.example-hospital.local/live/portal",
    "pendingPath": "/mirth/pending",
    "acknowledgePath": "/mirth/acknowledge",
    "resultsPath": "/mirth/labresult",
    "timeoutMs": 15000,
    "tlsRejectUnauthorized": true,
    "auditLog": "./logs/hmis.log"
  },

  "admin": {
    "host": "127.0.0.1",
    "port": 7071,
    "authFile": "./admin-auth.json"
  },

  // The console's "Force" button (Results tab, shown on a sample once HMIS has
  // taken at least one of its values): pushes EVERY value of that sample to the
  // HMIS results endpoint again, WITHOUT asking HMIS for its pending rows —
  // ids come from the order rows already cached for the barcode and the
  // parameter catalogue. For the day HMIS withdraws a sample's rows before the
  // interface has filed them (PL2609120001, 2026-09-12). It writes patient
  // results past the normal check, so it asks for this password every time
  // and is logged on every use. Empty = the button is not shown.
  "Force_Hmis": {
    "password": ""
  },

  // Auto Certify: replaces the old Certify_Results Windows service
  // (Auto_Certify.exe). Each run reads the HIS Oracle database for
  // machine-interfaced results that are ready for sign-off and certifies each
  // one through the HIS portal:
  //   GET <baseUrl><certifyPath>?labresultid=<id>           whole result
  //   GET <baseUrl><certifyPath>?labparameterresultid=<id>  per parameter, once none
  //                                                         of the result's parameters is
  //                                                         still in parameterResultStatus
  // It certifies patient results with nobody reviewing them, so it is OFF
  // until enabled. Stop the old service first, or both of them certify the
  // same results. The Oracle password can come from AUTOCERTIFY_ORACLE_PASSWORD
  // in the environment instead of this file. Console page: /auto-certify.
  //
  // Auto-Certify-only install: with "enabled": true, the "analyzers" list and
  // the "hmis" block can both be left out. The connector then runs no analyzer
  // links, only the certify job and the console.
  "autoCertify": {
    "enabled": false,
    "intervalSeconds": 30,
    "baseUrl": "http://his-portal.example-hospital.local:8050",
    "certifyPath": "/live/portal/labresult/autocertify",
    "timeoutMs": 15000,
    "siteId": "2",                        // LR.siteid (old SiteId)
    "equipmentIds": ["00000000"],         // ES.equipmentid (old EquipmentIds)
    "resultStatus": ["0000000", "000"],   // LR.result_status (old ResultStatus)
    "parameterResultStatus": ["0000"],    // LRP.parameterresultstatus that HOLDS a result back until the analyzer finishes it (old ParameterResultStatus)
    "lookbackDays": 2,                    // accepted today or in the previous N days
    "requireHod": true,                   // department must have an HOD
    "oracle": {
      "user": "",
      "password": "",
      "connectString": "db-host:1521/service_name"
    },
    "logFile": "./logs/autocertify.log"
  },

  "analyzers": [
    {
      // ---------------------------------------------------------------------
      // ASTM E1381/E1394 — e.g. VITROS ECi/ECiQ immunodiagnostic.
      //
      // `dialect` selects the vendor's record layout from the dialect library
      // (src/codec/astm/dialects.ts). An analyzer SILENTLY IGNORES an order it
      // cannot parse, so the wrong dialect looks exactly like a dead cable.
      // Entries today: "atellica", "maglumi", "vitros-eciq", "sysmex".
      // ---------------------------------------------------------------------
      "id": "example-astm",
      "equipmentCode": "EQCODE01",
      "equipmentId": 100000001,

      "protocol": "astm",

      // Serial alternative — an analyzer cabled straight to this PC, or one
      // behind a Moxa NPort left in Real COM mode.
      // "transport": {
      //   "type": "serial",
      //   "path": "COM3",
      //   "baudRate": 9600,
      //   "dataBits": 8,
      //   "stopBits": 1,
      //   "parity": "none",
      //   "dtr": true,
      //   "rts": true
      // },

      // Through a Moxa NPort in TCP Server mode. "client" means WE dial it.
      // A one-port NPort 5110 exposes serial port 1 on 4001 (NOT 4002); in
      // Real COM mode it listens on 950/966 instead and 4001 is closed.
      "transport": {
        "type": "tcp",
        "mode": "client",
        "host": "10.0.0.10",
        "port": 4001
      },

      "sendDemographics": true,
      "hostQuery": false,

      "qc": {
        "sampleIdPrefixes": ["QC", "QC-", "CTRL", "CONTROL", "$"],
        "sampleIdRegex": null
      },

      "astm": {
        "ackTimeoutMs": 15000,
        "frameMaxData": 240,
        // Match what the analyzer's own header carries. A VITROS ECiQ sends
        // sender "HOST" with NO receiver id, processing id or version.
        "senderId": "HOST",
        "receiverId": "",
        "dialect": "vitros-eciq"
        // Sysmex U-WAM only: it sends every value twice, "<v>^RAW" (native, /µl)
        // and "<v>^MAINFORMAT" (the reporting format set on the U-WAM — /HPF,
        // /LPF, "-" / "4+"). "main" (default) files what the lab sees on the
        // U-WAM; "raw" files the native value. Other analyzers are unaffected.
        // "valueFormat": "main",

      // Instrument value -> the WORD HMIS reports, per assay code, for
      // qualitative results. The sysmex-uwam profile carries the lab's table
      // for the strip pads ("-" -> Absent / Negative / Normal, "+-" -> trace,
      // nitrite "+" -> Positive; grades pass through). Exact value match,
      // case-insensitive; anything not listed is filed as sent. Override or
      // extend per site here:
      // "testValueMap": { "C-PRO": { "-": "Absent", "+-": "trace" } },

      // Decimal places a numeric value is rounded to before filing, per
      // assay code, for the parameters the report shows as whole numbers.
      // Half rounds up; a flag or "<0.1" is never touched. The Ahmedabad
      // urine report shows the four epithelial cell counts without a
      // decimal (2026-09-19):
      // "testCodeDecimals": { "EC": 0, "Squa.EC": 0, "Non SEC": 0, "RTEC": 0 },

      // HMIS identifier -> the code the INSTRUMENT recognises in an ORDER,
      // sent alongside the HMIS one. U-WAM ONLY: it reports strip items as
      // "C-GLU" but recognises only "GLU" in an order, and with an order it
      // recognises it outputs ONLY the recognised items - so an order of
      // "C-GLU" silently drops the strip half. The profile carries the
      // table; a value may be a list to try several spellings at once:
      // "downloadCodeAliases": { "C-GLU": "GLU", "C-S.G.(Ref)": ["S.G.", "S.G.(Ref)"] },

      // U-WAM ONLY: two analyzers share each tube and the U-WAM often sends
      // their halves as separate messages. The profile holds a sample until
      // BOTH have reported (names as written in ASTM R field 14) and files
      // it in one post; after maxWaitMs it files whatever it has, so a tube
      // run on one instrument, or a day with one instrument down, is delayed
      // at most this long. "maxWaitMs": null removes the limit — the sample
      // waits until both have reported and only the console's "file now"
      // releases a lone half. Tune the wait here; never set this on a
      // machine that is not a U-WAM.
      // "filing": { "mode": "staged", "pairing": { "devices": ["UC-3500", "UF-4000"], "maxWaitMs": 600000 } },
      }
    },
    {
      // ---------------------------------------------------------------------
      // KERMIT — the VITROS 250/350 chemistry systems. These do NOT speak ASTM:
      // sample programs and results move as named FILE TRANSFERS (SFILEn.D
      // outbound, R00000nn inbound). A separate protocol, not an ASTM dialect,
      // so there is no `dialect` key here.
      // ---------------------------------------------------------------------
      "id": "example-kermit",
      "equipmentCode": "EQCODE02",
      "equipmentId": 100000002,

      "protocol": "kermit",

      // "transport": {
      //   "type": "serial",
      //   "path": "COM2",
      //   "baudRate": 9600,
      //   "dataBits": 8,
      //   "stopBits": 1,
      //   "parity": "none",
      //   "dtr": true,
      //   "rts": true
      // },

      "transport": {
        "type": "tcp",
        "mode": "client",
        "host": "10.0.0.11",
        "port": 4001
      },

      "sendDemographics": true,
      "hostQuery": false,

      "qc": {
        "sampleIdPrefixes": ["QC", "QC-", "CTRL", "CONTROL", "$"],
        "sampleIdRegex": null
      },

      "kermit": {
        "ackTimeoutMs": 10000,
        "maxRetries": 5
      }
    },
    {
      // ---------------------------------------------------------------------
      // HL7 v2 over MLLP — e.g. Erba H360 haematology (CBC). The analyzer dials
      // US, so this side listens: mode "server", host = this PC's own address
      // on the lab VLAN.
      // ---------------------------------------------------------------------
      "id": "example-hl7",
      "equipmentCode": "EQCODE03",
      "machineId": 2002,

      "protocol": "hl7",

      "transport": {
        "type": "tcp",
        "mode": "server",
        "host": "10.0.0.5",
        "port": 3010
      },

      // Echoed in the acknowledge body; derived from the transport when unset.
      "ipAddress": "10.0.0.5",
      "portNo": "3010",

      "sendDemographics": false,
      "hostQuery": false,

      "qc": {
        "sampleIdPrefixes": ["QC", "QC-", "CTRL", "CONTROL", "$"],
        "sampleIdRegex": null
      },

      // Analyzer assay code -> the HMIS `eqIdntifier` naming the same analyte,
      // for cases where the two differ in NAME rather than spelling. Prefer
      // fixing the Identifier column in HMIS so there is one source of truth;
      // use this only for analytes HMIS names after the report line.
      "testCodeAliases": {
        // "HGB": "HAEMOGLOBIN",
        // "LYM%": "Lymphocytes"
      },

      // Complete a short sample id keyed on the instrument into the site's
      // full HMIS barcode (staged filing only). At Shela the H360 operators
      // type "SF" + the last four digits, or just the digits; HMIS calls the
      // sample SF<yymmdd><nnnn>. `short` must match the instrument's id whole
      // (case-insensitive) with ONE capture group = the sequence; `full` builds
      // the barcode from {yyyy} {yy} {mm} {dd} (the day the result arrived) and
      // {seq:N} (zero-padded). The built barcode is used only if HMIS has an
      // order under it; otherwise the sample waits on the console for a Re-key.
      // There is no suffix search — a wrong completion is a result on the wrong
      // patient. See src/results/complete.ts.
      // "barcodeCompletion": {
      //   "short": "(?:SF)?0*(\\d{1,4})",
      //   "full": "SF{yy}{mm}{dd}{seq:4}"
      // },

      "hl7": {
        "sendingApp": "LIS",
        "sendingFacility": "",
        "charset": "UNICODE",
        "ack": true,
        // OBX-2 value types that become filable results. ["NM"] keeps the
        // numeric analytes and drops IS-typed run modes, remarks and flags.
        "valueTypes": ["NM"],
        "encoding": "utf8",
        "idleFlushMs": 0
      }
    }

    // -----------------------------------------------------------------------
    // IM — an instrument MIDDLEWARE, not an analyzer: it runs the tubes on the
    // machines behind it and never asks the LIS for work. It LISTENS on a TCP
    // port and takes every order that is sent to it, which is what a Mirth
    // channel used to feed it. With this block the connector reads the orders
    // from HMIS itself, on the same pending poll every other machine uses, and
    // sends them to IM as HL7 ORM^O01 over MLLP.
    //
    // Everything below the first four lines comes from the "im" profile:
    // protocol hl7, transport tcp/client on 10011, a result listener on
    // 10012, orderPoll on, hostQuery off, demographics sent, staged filing,
    // and hl7.orderPush enabled. So a site block is the address and the
    // equipment code, nothing more.
    //
    // TWO CHANNELS. "transport" is the ORDER channel: the connector dials IM
    // and sends it work. "resultTransport" is the RESULT channel: the
    // connector listens and IM dials in with the same tubes and their values
    // (ORU^R01), which are joined to the orders that went out and filed. The
    // listening port is this PC's to choose — point IM's result connection at
    // <this PC>:10012, or write the port IM already uses. Both channels are
    // shown on the console's Auto Certify page.
    //
    // STOP THE MIRTH CHANNEL THAT FEEDS IM FIRST. Two systems sending the same
    // orders puts every tube on IM's worklist twice.
    //
    // The message layout is the HL7 v2 standard one and is confirmed by
    // reading IM's acknowledgement, not by a capture: an order counts as
    // delivered only when IM answers MSA|AA, and an AE/AR names what it did
    // not like in the log and on the console. Everything that might differ is
    // a setting — see "orderPush" below.
    //
    // A machine whose orders come from several HMIS sites lists them all in
    // siteIds: at Ahmedabad EQ0022 carries tubes from five (2, Chandkheda
    // 13873256, Vadodara 5866265, Anand 14, Ramanbhai 2567859), and polling
    // with one site alone hides the others' rows.
    // -----------------------------------------------------------------------
    // ,
    // {
    //   "id": "im",
    //   "profile": "im",
    //   "equipmentCode": "EQ0022",
    //   "equipmentId": 46150218,
    //   "siteIds": ["2", "13873256", "5866265", "14", "2567859"],
    //   "transport": { "host": "10.11.4.231" },
    //   "resultTransport": { "type": "tcp", "mode": "server", "host": "0.0.0.0", "port": 10012 },
    //
    //   // Only if IM asks for something other than the defaults:
    //   "hl7": {
    //     "orderPush": {
    //       "enabled": true,
    //       "messageType": "ORM^O01",   // or "OML^O21" for the v2.5 lab order
    //       "version": "2.3.1",         // MSH-12
    //       "receivingApp": "IM",       // MSH-5
    //       "receivingFacility": "",    // MSH-6
    //       "processingId": "P",        // MSH-11 — P production, T training
    //       "ackTimeoutMs": 15000       // no MSA in this long = not delivered
    //     }
    //   }
    // }
  ]
}
