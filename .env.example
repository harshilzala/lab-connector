# Optional environment overrides. Anything set here wins over config.json so the
# committed config file stays deployment-neutral. Copy to `.env`.

# Path to the config file (default: ./config.json)
# LAB_CONNECTOR_CONFIG=./config.json

# Override the HMIS base URL
# HMIS_BASE_URL=https://hmis.your-hospital.com

# Tatva v1 (hmis.tatva) — each wins over config.json when set
# TATVA_ENABLED=true
# TATVA_AUTH=equipment                      # equipment | oauth
# TATVA_BASE_URL=https://hmispreprod.zydushospitals.com
# TATVA_API_PREFIX=/external/v1             # oauth only
# TATVA_CLIENT_ID=                          # oauth only
# TATVA_CLIENT_SECRET=                      # oauth only
# TATVA_SCOPE=
# TATVA_API_KEY=                            # X-Api-Key, PROD when issued
# TATVA_FACILITY_ID=                        # X-Facility-ID
# TATVA_ORGANIZATION_ID=                    # X-Organization-ID
# TATVA_TLS_CERT_FILE=                      # mTLS, only if required
# TATVA_TLS_KEY_FILE=
# TATVA_TLS_CA_FILE=
# TATVA_TLS_PASSPHRASE=
# Per machine (equipment auth): <ID> = analyzer id upper-cased, "-" as "_"
# TATVA_EQUIPMENT_ID_MAGLUMI=
# TATVA_EQUIPMENT_SECRET_MAGLUMI=

# Log level: trace | debug | info | warn | error
# LOG_LEVEL=info

# Dashboard credential. ADMIN_USERNAME / ADMIN_PASSWORD are read only on the
# start that seeds admin-auth.json — afterwards the file is the source of truth
# and the password is changed from the dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Zydus@2026
# ADMIN_AUTH_FILE=./admin-auth.json

# Auto Certify: the HIS Oracle password, instead of autoCertify.oracle.password
# in config.json.
# AUTOCERTIFY_ORACLE_PASSWORD=
